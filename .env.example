# claude-monitor reads no secrets. Every variable below is optional; the value shown is the default.
# BOARD_HOST=127.0.0.1                          # bind address; anything but loopback is refused unless BOARD_ALLOW_REMOTE=1
# BOARD_ALLOW_REMOTE=                            # 1 = allow a non-loopback BOARD_HOST. The board has NO authentication: anyone who can reach the port can read and change it
# BOARD_PORT=8765
# BOARD_REGISTRY=~/.cache/claude-board/projects.json   # the machine-wide list of boards
# BOARD_DIR=                                     # override <main checkout>/.claude/board (tests, odd layouts)
# BOARD_TRANSCRIPTS_ROOT=~/.claude/projects      # where Claude Code writes the session transcripts
# BOARD_SKILLS_DIR=~/.claude/skills              # skills offered by the page's "run a skill" control
# BOARD_DECISION_WAIT=180                        # seconds the Stop hook waits for a board decision (0 = off, max 840)
# BOARD_SCRIPTS_DIR=~/.claude/scripts/board      # desktop window only: where it finds board_open.py
# AUDIT_FETCH_TRIES=3                            # gate only: cargo audit attempts before the advisory database counts as unreachable (NOT RUN)
# AUDIT_FETCH_PAUSE=5                            # gate only: seconds between those attempts

# Every variable the code reads (global #16). Real values live in the environment or a secret store, never here.
# The API reads them in one place: src/ClaudeMonitor.Api/Config/ApiConfig.cs. In Development a missing value falls
# back to the default shown; outside Development a missing required value stops the API at start.

# ---- API: required outside Development ----
MONITOR_DB=Host=localhost;Port=55432;Database=monitor;Username=monitor;Password=<secret>   # PostgreSQL 18
MONITOR_PUBLIC_ORIGIN=http://localhost:5173        # the web's origin: mail links, CSRF check, OAuth return. https outside development (http only on loopback); cookies are Secure on https
MONITOR_SMTP_HOST=localhost                        # production: smtp.gmail.com
MONITOR_SMTP_PORT=1025                             # production: 587 (STARTTLS)
MONITOR_SMTP_FROM=monitor@localhost                # the sending address
MONITOR_ARCHIVE_DIR=/var/lib/claude-monitor/archive   # zipped day files of events past retention

# ---- API: optional ----
MONITOR_SMTP_USER=                                 # production: the Google Workspace / Gmail account
MONITOR_SMTP_PASSWORD=<secret>                     # an app password of that account
MONITOR_SMTP_TLS=true                              # STARTTLS; default true outside Development, false in it (Mailpit)
MONITOR_GITHUB_CLIENT_ID=                          # GitHub sign-in; without both values GitHub is not offered
MONITOR_GITHUB_CLIENT_SECRET=<secret>
MONITOR_GOOGLE_CLIENT_ID=                          # Google sign-in; without both values Google is not offered
MONITOR_GOOGLE_CLIENT_SECRET=<secret>
MONITOR_WEB_ROOT=                                  # the built web app (web/dist) the API serves on the same origin
MONITOR_COMMIT=dev                                 # the deployed commit, answered by /api/version (the prod gate checks it)
MONITOR_MIN_AGENT_VERSION=0.1.0                    # older agents get 426 Upgrade Required
MONITOR_TRUST_PROXY=false                          # true behind the TLS reverse proxy (X-Forwarded-For/-Proto)
MONITOR_BACKGROUND_JOBS=on                         # off = no housekeeping or archiving (tests)
MONITOR_AUTH_RATE_PER_MINUTE=20                    # sign-in, sign-up, reset and device-code requests per IP per minute

# ---- Agent (cm-agent): all optional; read only in src/ClaudeMonitor.Agent/Config/AgentConfig.cs ----
CM_AGENT_HOME=                                     # default: macOS ~/Library/Application Support/ClaudeMonitor, Windows %LOCALAPPDATA%\ClaudeMonitor
CM_SERVER=                                         # the API's origin when `cm-agent login` gets no --server
CM_PERMISSION_WAIT=120                             # seconds a permission prompt waits for an answer from the web (max 590)
CM_STOP_WAIT=0                                     # seconds the Stop hook waits for a prompt from the web (0 = none, max 590)
CM_CREDENTIALS=keychain                            # keychain (default) | file: tests only, tokens in user-only files

# ---- Tests ----
E2E_EMAIL_BASE=<account>@gmail.com                 # test addresses become <account>+<tag>@gmail.com (global #30)
E2E_BASE_URL=                                      # the test environment; unset = a local stack (e2e/serve-local.sh)
E2E_MAILPIT_URL=http://127.0.0.1:8125              # where the e2e suite reads the mails the app sent
E2E_PORT=5190                                      # the local stack's port

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Line coverage, collected only when COVERAGE_DIR is set (tests/coverage.props). -->
  <Import Project="..\coverage.props" />
  <!-- This codebase is the tray (aipod-tray) only. The agent (cm-agent) and the contracts are measured by their own test projects, so their assemblies
       are left out here by name: this is not hand-written code of this codebase being removed from the count. (An Include filter on the hyphenated
       name `[aipod-tray]*` does not select anything in coverlet, hence the Exclude; `[cm*]*` is the pattern that matches `cm-agent`.) -->
  <PropertyGroup Condition="'$(COVERAGE_DIR)' != ''">
    <Exclude>[cm*]*,[ClaudeMonitor.*]*</Exclude>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.msbuild" Version="6.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- The core headless platform (MIT, same family as Avalonia): it works with any test framework, unlike Avalonia.Headless.XUnit, which needs xunit v3. -->
    <PackageReference Include="Avalonia.Headless" Version="12.1.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Aipod.Tray\Aipod.Tray.csproj" />
  </ItemGroup>

</Project>

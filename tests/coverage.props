<Project>
  <!--
    Coverage collection for the test projects (global #29), switched on by the environment: when COVERAGE_DIR is set
    (the gate's unit-test step sets it, scripts/merge-gate.conf) the test run itself collects line coverage and writes a
    Cobertura file to $(COVERAGE_DIR)/<test project>/, so the coverage step reads it instead of running every test a second
    time. Without COVERAGE_DIR nothing here applies and `dotnet test` is a plain test run.
    The thresholds are NOT here: scripts/coverage.sh judges the numbers (COVERAGE_MIN, 80), a test run only collects them.

    THE EXCLUSION LIST for .NET (generated code only, one place, a reason per entry):
      **/Data/Migrations/*.cs   EF Core migrations and the model snapshot, generated by `dotnet ef`.
      **/obj/**/*.cs            compiler output: source generators' code (the [GeneratedRegex] implementations).
    Each test project names the assemblies it measures (the Include property) next to its package references.
  -->
  <PropertyGroup Condition="'$(COVERAGE_DIR)' != ''">
    <CollectCoverage>true</CollectCoverage>
    <CoverletOutputFormat>cobertura</CoverletOutputFormat>
    <CoverletOutput>$(COVERAGE_DIR)/$(MSBuildProjectName)/</CoverletOutput>
    <ExcludeByFile>**/Data/Migrations/*.cs,**/obj/**/*.cs</ExcludeByFile>
  </PropertyGroup>
</Project>

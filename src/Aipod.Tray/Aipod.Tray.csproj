<Project Sdk="Microsoft.NET.Sdk">

  <!-- The tray app and status window (aipod). One Avalonia program for Windows and macOS (approved 19/10/2026: Avalonia 12.1.4, MIT, net10.0).
       It opens no network port: it reads the agent's database and runs the aipod command line for what it is asked to do. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>aipod-tray</AssemblyName>
    <RootNamespace>Aipod.Tray</RootNamespace>
    <Version>0.5.1</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClaudeMonitor.Agent\ClaudeMonitor.Agent.csproj" />
    <InternalsVisibleTo Include="Aipod.Tray.Tests" />
  </ItemGroup>

</Project>

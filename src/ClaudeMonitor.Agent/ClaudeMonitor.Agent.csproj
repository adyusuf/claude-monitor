<Project Sdk="Microsoft.NET.Sdk">

  <!-- The agent (ADR-0002): one self-contained binary per OS/arch, named cm-agent. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>cm-agent</AssemblyName>
    <RootNamespace>ClaudeMonitor.Agent</RootNamespace>
    <Version>0.3.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TieredPGO>true</TieredPGO>
    <!-- setsid() through LibraryImport (DaemonHost) -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Release publishing: dotnet publish -c Release -r <osx-arm64|osx-x64|win-x64|win-arm64> -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- NEVER true: a compressed bundle crashed the macOS daemon within seconds (AccessViolationException in
         System.Net.Http) with or without ReadyToRun, and starts twice as slowly (docs/adr-0002-agent-platform.md,
         "Published build"). scripts/agent_smoke.py runs the published daemon to keep it so. -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <!-- One image per assembly, not one composite of the whole framework: 81 MB instead of 108 MB, same startup. -->
    <PublishReadyToRunComposite>false</PublishReadyToRunComposite>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageReference Include="ModelContextProtocol" Version="2.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClaudeMonitor.Contracts\ClaudeMonitor.Contracts.csproj" />
    <InternalsVisibleTo Include="ClaudeMonitor.Agent.Tests" />
  </ItemGroup>

</Project>
